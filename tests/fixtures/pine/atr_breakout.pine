//@version=6
// AGentTrXPAUS Auto-Generated Trading Strategy: XAU_ATR_DONCHIAN_BREAKOUT
// Strategy ID: 6086c54f-9291-40b3-954a-f552920ad2ed
// Hypothesis: Expansion above Donchian 20-period upper channel captures structural breakouts.
// Target Instrument: XAUUSD | Timeframe: 1h
// Direction: LONG | Regimes: ['BREAKOUT']
// Transpiled: 2026-10-12T12:06:54Z

strategy(title="XAU_ATR_DONCHIAN_BREAKOUT", shorttitle="XAU_ATR_DONCHIAN", overlay=true,
         initial_capital=10000.0,
         default_qty_type=strategy.percent_of_equity, default_qty_value=1.0,
         commission_type=strategy.commission.percent, commission_value=0.0500,
         slippage=1, pyramiding=0,
         process_orders_on_close=true,
         calc_on_every_tick=false,
         calc_on_order_fills=false)

// ============================================================================
// Strategy Inputs & Tunable Parameters
// ============================================================================
p_donchian_period = input.int(20, title="Donchian Period", minval=10, maxval=50, step=1, group="Strategy Parameters")

// Risk & Position Management Inputs
p_sl_multiplier = input.float(2.00, title="Stop Loss Multiplier (ATR_MULTIPLE)", minval=0.1, step=0.1, group="Risk Management")
p_tp_multiplier = input.float(2.50, title="Take Profit Multiplier (RISK_REWARD_RATIO)", minval=0.1, step=0.1, group="Risk Management")
p_max_holding_bars = input.int(72, title="Max Holding Bars", minval=1, maxval=500, group="Risk Management")

// ============================================================================
// Technical Indicators (Strict Non-Repainting Calculation)
// ============================================================================
// Baseline ATR for volatility-adjusted stop-loss & take-profit
atr_baseline = ta.atr(14)

donchian_20_upper = ta.highest(high, 20)
donchian_20_lower = ta.lowest(low, 20)
donchian_20_mid = math.avg(donchian_20_upper, donchian_20_lower)
donchian_20 = donchian_20_upper

atr_14 = ta.atr(14)


// ============================================================================
// Market Session Constraints (UTC Standard)
// ============================================================================
session_allowed = true

// ============================================================================
// Entry & Exit Conditions
// ============================================================================
entry_rule_triggered = (close > donchian_20_upper[1])
exit_rule_triggered = (close < donchian_20_mid)

can_enter = entry_rule_triggered and session_allowed

// ============================================================================
// Stop-Loss & Take-Profit Calculation
// ============================================================================
sl_distance = math.max(atr_baseline * p_sl_multiplier, 0.50)
tp_distance = math.max(sl_distance * p_tp_multiplier, 0.75)

// ============================================================================
// Order Execution & Trade Lifecycle Management
// ============================================================================
if can_enter and strategy.position_size == 0
    strategy.entry("XAU_ATR_DONCHIAN_BREAKOUT_Long", strategy.long)

if strategy.position_size > 0
    sl_price = strategy.position_avg_price - sl_distance
    tp_price = strategy.position_avg_price + tp_distance
    strategy.exit("XAU_ATR_DONCHIAN_BREAKOUT_ExitLong", from_entry="XAU_ATR_DONCHIAN_BREAKOUT_Long", stop=sl_price, limit=tp_price)

if exit_rule_triggered and strategy.position_size > 0
    strategy.close("XAU_ATR_DONCHIAN_BREAKOUT_Long", comment="Exit Rule Triggered")

if p_max_holding_bars > 0 and strategy.position_size > 0
    in_trade = strategy.position_size > 0
    bars_in_trade = ta.barssince(in_trade and not in_trade[1])
    if bars_in_trade >= p_max_holding_bars
        strategy.close("XAU_ATR_DONCHIAN_BREAKOUT_Long", comment="Max Holding Exceeded")

// ============================================================================
// Visual Indicators & Execution Diagnostics
// ============================================================================
plot(donchian_20_upper, title="DONCHIAN_20 Channel High", color=color.teal)
plot(donchian_20_lower, title="DONCHIAN_20 Channel Low", color=color.teal)