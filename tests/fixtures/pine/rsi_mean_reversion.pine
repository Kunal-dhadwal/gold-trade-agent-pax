//@version=6
// AGentTrXPAUS Auto-Generated Trading Strategy: XAU_RSI_BOLLINGER_REVERSION
// Strategy ID: cf0b980d-d020-45bc-b5c9-8f4e82ccbae9
// Hypothesis: Oversold RSI touching lower Bollinger Band indicates exhaustion in Gold.
// Target Instrument: XAUUSD | Timeframe: 1h
// Direction: LONG | Regimes: ['RANGING']
// Transpiled: 2026-10-12T12:06:54Z

strategy(title="XAU_RSI_BOLLINGER_REVERSION", shorttitle="XAU_RSI_BOLLINGE", overlay=true,
         initial_capital=10000.0,
         default_qty_type=strategy.percent_of_equity, default_qty_value=1.0,
         commission_type=strategy.commission.percent, commission_value=0.0500,
         slippage=1, pyramiding=0,
         process_orders_on_close=true,
         calc_on_every_tick=false,
         calc_on_order_fills=false)

// ============================================================================
// Strategy Inputs & Tunable Parameters
// ============================================================================
p_rsi_oversold = input.float(30.0, title="Rsi Oversold", minval=15.0000, maxval=40.0000, step=1.0000, group="Strategy Parameters")

// Risk & Position Management Inputs
p_sl_multiplier = input.float(1.50, title="Stop Loss Multiplier (ATR_MULTIPLE)", minval=0.1, step=0.1, group="Risk Management")
p_tp_multiplier = input.float(2.00, title="Take Profit Multiplier (RISK_REWARD_RATIO)", minval=0.1, step=0.1, group="Risk Management")
p_max_holding_bars = input.int(36, title="Max Holding Bars", minval=1, maxval=500, group="Risk Management")

// ============================================================================
// Technical Indicators (Strict Non-Repainting Calculation)
// ============================================================================
// Baseline ATR for volatility-adjusted stop-loss & take-profit
atr_baseline = ta.atr(14)

rsi_14 = ta.rsi(close, 14)

[bb_20_middle, bb_20_upper, bb_20_lower] = ta.bb(close, 20, 2.0)
bb_20 = bb_20_middle
bb_20_bandwidth = (bb_20_upper - bb_20_lower) / bb_20_middle
bb_20_percent_b = (close - bb_20_lower) / (bb_20_upper - bb_20_lower)


// ============================================================================
// Market Session Constraints (UTC Standard)
// ============================================================================
session_allowed = (hour >= 8 and hour < 16) or (hour >= 13 and hour < 21)

// ============================================================================
// Entry & Exit Conditions
// ============================================================================
entry_rule_triggered = ((rsi_14 <= 30) and (low <= bb_20_lower))
exit_rule_triggered = (close >= bb_20_middle)

can_enter = entry_rule_triggered and session_allowed

// ============================================================================
// Stop-Loss & Take-Profit Calculation
// ============================================================================
sl_distance = math.max(atr_baseline * p_sl_multiplier, 0.50)
tp_distance = math.max(sl_distance * p_tp_multiplier, 0.75)

// ============================================================================
// Order Execution & Trade Lifecycle Management
// ============================================================================
if can_enter and strategy.position_size == 0
    strategy.entry("XAU_RSI_BOLLINGER_REVERSION_Long", strategy.long)

if strategy.position_size > 0
    sl_price = strategy.position_avg_price - sl_distance
    tp_price = strategy.position_avg_price + tp_distance
    strategy.exit("XAU_RSI_BOLLINGER_REVERSION_ExitLong", from_entry="XAU_RSI_BOLLINGER_REVERSION_Long", stop=sl_price, limit=tp_price)

if exit_rule_triggered and strategy.position_size > 0
    strategy.close("XAU_RSI_BOLLINGER_REVERSION_Long", comment="Exit Rule Triggered")

if p_max_holding_bars > 0 and strategy.position_size > 0
    in_trade = strategy.position_size > 0
    bars_in_trade = ta.barssince(in_trade and not in_trade[1])
    if bars_in_trade >= p_max_holding_bars
        strategy.close("XAU_RSI_BOLLINGER_REVERSION_Long", comment="Max Holding Exceeded")

// ============================================================================
// Visual Indicators & Execution Diagnostics
// ============================================================================
plot(bb_20_upper, title="BB_20 Upper", color=color.gray)
plot(bb_20_lower, title="BB_20 Lower", color=color.gray)