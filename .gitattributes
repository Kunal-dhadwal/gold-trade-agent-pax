# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.pine text eol=lf

# Explicit binary files
*.parquet binary
*.db binary
*.tar.gz binary
*.zip binary
*.png binary
*.jpg binary
