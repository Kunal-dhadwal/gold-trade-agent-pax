# ==============================================================================
# GOLD AI TRADING AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database Configuration (PostgreSQL 16 in Docker / production; SQLite for local fallback)
# Production: postgresql+asyncpg://postgres:postgres@localhost:5432/gold_trading
# Local dev fallback: sqlite+aiosqlite:///./data/gold_trading.db
DATABASE_URL=sqlite+aiosqlite:///./data/gold_trading.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Cache Configuration (Redis 7 in Docker / production)
# Production: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Storage Paths
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
NORMALIZED_DATA_DIR=./data/normalized
TIMEFRAME_DATA_DIR=./data/timeframe
QUALITY_REPORTS_DIR=./data/quality_reports

# Delta Exchange Public / Authenticated Configuration
DELTA_API_BASE_URL=https://api.delta.exchange
DELTA_TESTNET_API_BASE_URL=https://testnet-api.delta.exchange
DELTA_WS_URL=wss://socket.delta.exchange
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_TESTNET=true

# Operational Trading Flags (CRITICAL SAFETY)
LIVE_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true

# Risk Engine Default Parameters
MAX_DAILY_LOSS_PCT=2.0
MAX_PORTFOLIO_DRAWDOWN_PCT=6.0
MAX_RISK_PER_TRADE_PCT=1.0
MAX_CONCURRENT_POSITIONS=1
MAX_CONSECUTIVE_LOSSES=4
MIN_RISK_REWARD_RATIO=1.5
